  },
  "homepage": "https://github.com/urban-toolkit/autarkjs.org#readme",
  "devDependencies": {
    "playwright-core": "^1.65.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitepress": "^1.6.3"
  },
  "overrides": {
    "vitepress": {
      "vite": "^6.4.4"
    }
  },
