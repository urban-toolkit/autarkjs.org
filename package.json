  "scripts": {
    "postinstall": "node .scripts/fix-duckdb-sourcemap.cjs && node .scripts/sync-duckdb-assets.cjs",
    "prebuild": "node .scripts/sync-duckdb-assets.cjs && node .scripts/sync-grammar-schema.cjs && npm run usecases:build && npm run gallery:assets && npm run gallery:build && npm run tutorial:build",
    "predev": "node .scripts/sync-grammar-schema.cjs && npm run usecases:build && npm run gallery:assets && npm run gallery:build && npm run tutorial:build",
    "usecases:build": "vite build --config usecases/vite.config.ts",
    "test:usecases": "node --test .scripts/test-usecases.mjs",
    "dev": "vitepress dev guide",
    "build": "vitepress build guide",
    "release:prepare": "node .scripts/prepare-autark-release.mjs",
    "preview": "vitepress preview guide",
    "gallery:build": "node .scripts/gallery-gate.mjs || vite build --config gallery/vite.config.ts",
    "gallery:dev": "vite --config gallery/vite.config.ts",
    "test:gallery": "node --test .scripts/test-gallery.mjs",
    "gallery:shots": "node .scripts/capture-gallery.mjs guide/public/imgs/gallery",
    "gallery:pages": "node .scripts/generate-gallery-pages.mjs",
    "gallery:assets": "node .scripts/sync-gallery-assets.mjs",
    "api:polish": "node .scripts/polish-api-docs.mjs",
    "tutorial:build": "vite build --config tutorial/vite.config.ts",
    "tutorial:dev": "vite --config tutorial/vite.config.ts",
    "test:tutorial": "node --test .scripts/test-tutorial.mjs",
    "test:tutorial:browser": "node .scripts/test-tutorial-browser.mjs",
    "test:playground": "node .scripts/test-playground-browser.mjs"
  },
  "repository": {
    "type": "git",
