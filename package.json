    "@urban-toolkit/autk-db": "file:vendor/autark-5.0.0/urban-toolkit-autk-db-5.0.0.tgz",
    "@urban-toolkit/autk-grammar": "5.6.0",
    "@urban-toolkit/autk-map": "file:vendor/autark-5.0.0/urban-toolkit-autk-map-5.0.0.tgz",
    "@urban-toolkit/autk-plot": "file:vendor/autark-5.0.0/urban-toolkit-autk-plot-5.0.0.tgz",
    "highlight.js": "^11.12.0"
  }
