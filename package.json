{
  "name": "autarkjs.org",
  "version": "1.0.0",
  "description": "",
  "main": "ex1.js",
  "directories": {
    "example": "gallery"
  },
  "scripts": {
    "postinstall": "node .scripts/fix-duckdb-sourcemap.cjs && node .scripts/sync-duckdb-assets.cjs",
    "prebuild": "node .scripts/sync-duckdb-assets.cjs && node .scripts/sync-grammar-schema.cjs && npm run usecases:build && npm run gallery:assets && npm run gallery:build",
    "predev": "node .scripts/sync-grammar-schema.cjs && npm run usecases:build && npm run gallery:assets && npm run gallery:build",
    "usecases:build": "vite build --config usecases/vite.config.ts",
    "test:usecases": "node --test .scripts/test-usecases.mjs",
    "dev": "vitepress dev guide",
    "build": "vitepress build guide",
    "release:prepare": "node .scripts/prepare-autark-release.mjs",
    "preview": "vitepress preview guide",
    "gallery:build": "node .scripts/gallery-gate.mjs || vite build --config gallery/vite.config.ts",
    "gallery:dev": "vite --config gallery/vite.config.ts",
    "test:gallery": "node --test .scripts/test-gallery.mjs",
    "gallery:shots": "node .scripts/capture-gallery.mjs guide/public/imgs/gallery",
    "gallery:pages": "node .scripts/generate-gallery-pages.mjs",
    "gallery:assets": "node .scripts/sync-gallery-assets.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/urban-toolkit/autarkjs.org.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/urban-toolkit/autarkjs.org/issues"
  },
  "homepage": "https://github.com/urban-toolkit/autarkjs.org#readme",
  "devDependencies": {
    "playwright-core": "^1.65.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitepress": "^1.6.3"
  },
  "overrides": {
    "vitepress": {
      "vite": "^6.4.4"
    }
  },
  "dependencies": {
    "@urban-toolkit/autk": "4.1.1",
    "@urban-toolkit/autk-compute": "4.1.1",
    "@urban-toolkit/autk-core": "4.1.1",
    "@urban-toolkit/autk-db": "4.1.1",
    "@urban-toolkit/autk-grammar": "5.6.0",
    "@urban-toolkit/autk-map": "4.1.1",
    "@urban-toolkit/autk-plot": "4.1.1",
    "highlight.js": "^11.12.0"
  }
}
